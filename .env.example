# Browser configuration. These values are intentionally public.
# Use the same shared project URL/public key in the matching server settings.
# Dedicated schema simple_grant and bucket simple-grant-documents are code constants.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_INBOUND_EMAIL_DOMAIN=mail.thesimpleai.com

# Netlify Functions only. Never prefix these with VITE_.
# The service role/secret key is privileged across the ENTIRE shared project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_API_KEY
# Alias follows the provider's current Flash model; confirm capabilities before launch.
GEMINI_MODEL=gemini-flash-latest
RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=YOUR_RESEND_WEBHOOK_SIGNING_SECRET
# Optional public-only question routing; private questions go to the portal.
EMAIL_AI_REPLIES=false
# Optional fixed receipt, used only when AI replies are disabled.
EMAIL_AUTO_ACK=false

# Use a sending identity and inbound domain you own and have verified in Resend.
EMAIL_FROM=Simple Grant <grants@thesimpleai.com>
INBOUND_EMAIL_DOMAIN=mail.thesimpleai.com

# Netlify supplies URL in production. Set for local Netlify development only.
URL=http://localhost:8888
